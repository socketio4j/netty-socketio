#!/usr/bin/env bash
# ==============================================================================
# SocketIO4J - Pre-Commit Integrity Shield
# Enforces security, hygiene, Checkstyle, compilation, and event-loop lock safety.
# ==============================================================================
set -u

SCRIPT_START_SECONDS=$SECONDS

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m' # No Color

# ------------------------------------------------------------------------------
# 0. Optional Delegation to Python pre-commit framework
# Set PRE_COMMIT_USE_FRAMEWORK=1 to delegate directly to pre-commit CLI.
# ------------------------------------------------------------------------------
if [ "${PRE_COMMIT_USE_FRAMEWORK:-0}" = "1" ] && [ -f ".pre-commit-config.yaml" ]; then
    echo -e "${CYAN}ℹ [FRAMEWORK]${NC} PRE_COMMIT_USE_FRAMEWORK=1 detected. Delegating to pre-commit framework..."
    if command -v pre-commit > /dev/null 2>&1; then
        exec pre-commit run --hook-stage pre-commit --verbose
    elif command -v python3 > /dev/null 2>&1 && python3 -m pre_commit --version > /dev/null 2>&1; then
        exec python3 -m pre_commit run --hook-stage pre-commit --verbose
    fi
fi

# ------------------------------------------------------------------------------
# Header & Environment Inspection
# ------------------------------------------------------------------------------
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}🔒 SocketIO4J Pre-Commit Integrity Shield${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
COMMIT_AUTHOR=$(git config user.name 2>/dev/null || echo "unconfigured")
COMMIT_EMAIL=$(git config user.email 2>/dev/null || echo "unconfigured")

echo -e "  ${DIM}• Branch:${NC} ${BOLD}${CURRENT_BRANCH}${NC}"
echo -e "  ${DIM}• Author:${NC} ${COMMIT_AUTHOR} <${COMMIT_EMAIL}>"

# Identify staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✔ [PASS]${NC} No staged files to check. Proceeding with commit."
    exit 0
fi

STAGED_COUNT=$(echo "$STAGED_FILES" | grep -c . || echo 0)
echo -e "  ${DIM}• Staged Files:${NC} ${BOLD}${STAGED_COUNT}${NC} file(s) undergoing verification:"

if [ "$STAGED_COUNT" -le 12 ]; then
    git diff --cached --name-status | while IFS=$'\t' read -r status filepath; do
        [ -z "$filepath" ] && continue
        case "$status" in
            A*) echo -e "    ${GREEN}[+ Added]${NC}    $filepath" ;;
            M*) echo -e "    ${YELLOW}[~ Modified]${NC} $filepath" ;;
            R*) echo -e "    ${BLUE}[→ Renamed]${NC}  $filepath" ;;
            *)  echo -e "    ${DIM}[$status]${NC}         $filepath" ;;
        esac
    done
else
    git diff --cached --name-status | head -n 8 | while IFS=$'\t' read -r status filepath; do
        [ -z "$filepath" ] && continue
        echo -e "    ${DIM}[$status]${NC} $filepath"
    done
    REMAINING=$(( STAGED_COUNT - 8 ))
    echo -e "    ${DIM}... and ${REMAINING} more file(s)${NC}"
fi
echo -e "${CYAN}──────────────────────────────────────────────────────────────────${NC}"

FAILED_GATES=0
GATE1_STATUS="PASSED"
GATE2_STATUS="PASSED"
GATE3_STATUS="PASSED"
GATE4_STATUS="PASSED"
GATE5_STATUS="PASSED"
GATE6_STATUS="PASSED"
GATE7_STATUS="PASSED"
GATE8_STATUS="PASSED"

# ------------------------------------------------------------------------------
# Gate 1: Prohibited Certificate & Key Security Check
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 1/8] Prohibited Certificate & Key Security Check${NC}"
echo -e "  ${DIM}Policy: Prohibit private key and certificate files outside test resources.${NC}"

FORBIDDEN_CERT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(pem|key|pkcs8|crt|der)$' | grep -v 'src/test/resources/' || true)
if [ -n "$FORBIDDEN_CERT_FILES" ]; then
    echo -e "  ${RED}❌ [FAIL] Prohibited certificate / private key file(s) staged:${NC}"
    echo "$FORBIDDEN_CERT_FILES" | while IFS= read -r f; do
        [ -z "$f" ] && continue
        echo -e "     ${RED}✗${NC} $f"
    done
    echo -e "  ${YELLOW}💡 Remediation:${NC} Run ${BOLD}git restore --staged <file>${NC}."
    GATE1_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
else
    echo -e "  ${GREEN}✔ [PASS]${NC} 0 prohibited certificate/key files found across ${STAGED_COUNT} staged file(s)."
fi

# ------------------------------------------------------------------------------
# Gate 2: Secret & Private Key Content Detection in Staged Diffs
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 2/8] Secret & Private Key Content Scanning${NC}"
echo -e "  ${DIM}Policy: Inspect diff additions for embedded private keys and secret blocks.${NC}"

KEY_HEADER="BEGIN"
KEY_FOOTER="PRIVATE KEY"
MATCHED_DIFF=$(git diff --cached --unified=0 --output-indicator-new='>' -- . ':(exclude).githooks/pre-commit' ':(exclude)**/src/test/resources/**' | \
    grep -E "^>.*${KEY_HEADER} (RSA |EC |OPENSSH |DSA )?${KEY_FOOTER}" || true)

if [ -n "$MATCHED_DIFF" ]; then
    echo -e "  ${RED}❌ [FAIL] Detected raw private key block in staged additions!${NC}"
    echo "$MATCHED_DIFF" | head -n 10 | while IFS= read -r line; do
        echo -e "     ${RED}✗${NC} ${DIM}${line}${NC}"
    done
    echo -e "  ${YELLOW}💡 Remediation:${NC} Remove embedded private keys. Never commit secret key material."
    GATE2_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
else
    echo -e "  ${GREEN}✔ [PASS]${NC} Clean diff scan: zero embedded private key headers detected."
fi

# ------------------------------------------------------------------------------
# Gate 3: Merge Conflict Markers Check
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 3/8] Merge Conflict Markers Check${NC}"
echo -e "  ${DIM}Policy: Ensure no unresolved conflict markers (<<<<<<<, =======, >>>>>>>) are staged.${NC}"

CONFLICT_FILES=""
while IFS= read -r file; do
    [ -z "$file" ] && continue
    case "$file" in
        *.md|*.rst) continue ;;
    esac
    if git diff --cached --unified=0 -- "$file" 2>/dev/null | grep -E '^\+[<>=]{7}( |$)' > /dev/null 2>&1; then
        CONFLICT_FILES="${CONFLICT_FILES}${file}"$'\n'
    fi
done <<< "$STAGED_FILES"

if [ -n "$CONFLICT_FILES" ]; then
    echo -e "  ${RED}❌ [FAIL] Unresolved merge conflict markers detected in:${NC}"
    echo "$CONFLICT_FILES" | while IFS= read -r f; do
        [ -z "$f" ] && continue
        echo -e "     ${RED}✗${NC} $f"
    done
    echo -e "  ${YELLOW}💡 Remediation:${NC} Resolve conflicts, remove markers, and stage the resolved file."
    GATE3_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
else
    echo -e "  ${GREEN}✔ [PASS]${NC} Clean diff scan: zero unresolved merge conflict markers."
fi

# ------------------------------------------------------------------------------
# Gate 4: OS & Editor Junk Files Check
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 4/8] OS & Editor Temporary Artifacts Check${NC}"
echo -e "  ${DIM}Policy: Prohibit temporary or system files (.DS_Store, Thumbs.db, *.swp, *.orig, etc.)${NC}"

JUNK_FILES=$(echo "$STAGED_FILES" | grep -E '(\.DS_Store|Thumbs\.db|\.orig$|\.rej$|~$|\.swp$|\.bak$)' || true)
if [ -n "$JUNK_FILES" ]; then
    echo -e "  ${RED}❌ [FAIL] Prohibited temporary / OS junk file(s) staged:${NC}"
    echo "$JUNK_FILES" | while IFS= read -r f; do
        [ -z "$f" ] && continue
        echo -e "     ${RED}✗${NC} $f"
    done
    echo -e "  ${YELLOW}💡 Remediation:${NC} Run ${BOLD}git rm --cached <file>${NC} and verify your .gitignore."
    GATE4_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
else
    echo -e "  ${GREEN}✔ [PASS]${NC} No OS junk or temporary editor artifacts staged."
fi

# ------------------------------------------------------------------------------
# Gate 5: File Size Safety Check (Limit: 500 KB per file)
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 5/8] File Size Safety Check${NC}"
MAX_FILE_SIZE_KB=500
echo -e "  ${DIM}Policy: Staged files must not exceed ${MAX_FILE_SIZE_KB} KB.${NC}"

LARGE_FILES=""
MAX_OBSERVED_KB=0
LARGEST_FILE=""

while IFS= read -r file; do
    [ -z "$file" ] && continue
    file_size_bytes=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
    file_size_kb=$(( file_size_bytes / 1024 ))
    if [ "$file_size_kb" -gt "$MAX_OBSERVED_KB" ]; then
        MAX_OBSERVED_KB=$file_size_kb
        LARGEST_FILE="$file"
    fi
    if [ "$file_size_kb" -gt "$MAX_FILE_SIZE_KB" ]; then
        LARGE_FILES="${LARGE_FILES}\n     ${RED}✗${NC} $file (${file_size_kb} KB > ${MAX_FILE_SIZE_KB} KB)"
    fi
done <<< "$STAGED_FILES"

if [ -n "$LARGE_FILES" ]; then
    echo -e "  ${RED}❌ [FAIL] Staged file(s) exceed maximum allowed size (${MAX_FILE_SIZE_KB} KB):${NC}"
    echo -e "$LARGE_FILES"
    GATE5_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
else
    if [ -n "$LARGEST_FILE" ]; then
        echo -e "  ${GREEN}✔ [PASS]${NC} All files within quota (largest: ${LARGEST_FILE} at ${MAX_OBSERVED_KB} KB / ${MAX_FILE_SIZE_KB} KB)."
    else
        echo -e "  ${GREEN}✔ [PASS]${NC} All files within quota (limit: ${MAX_FILE_SIZE_KB} KB)."
    fi
fi

# ------------------------------------------------------------------------------
# Gate 6: Whitespace, Line Endings & Formatting Check
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 6/8] Whitespace, Line Endings & Formatting Check${NC}"
echo -e "  ${DIM}Policy: Disallow trailing whitespace and whitespace errors.${NC}"

WHITESPACE_ERROR=0
WHITESPACE_OUTPUT=$(git diff --cached --check 2>&1 || true)

if [ -n "$WHITESPACE_OUTPUT" ]; then
    echo -e "  ${RED}❌ [FAIL] Staged changes contain whitespace or formatting errors:${NC}"
    echo "$WHITESPACE_OUTPUT" | head -n 15 | while IFS= read -r line; do
        echo -e "     ${RED}✗${NC} $line"
    done
    LINES_COUNT=$(echo "$WHITESPACE_OUTPUT" | grep -c . || echo 0)
    if [ "$LINES_COUNT" -gt 15 ]; then
        echo -e "     ${DIM}... and $(( LINES_COUNT - 15 )) more violation line(s).${NC}"
    fi
    WHITESPACE_ERROR=1
fi

if [ "$WHITESPACE_ERROR" -eq 1 ]; then
    GATE6_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
else
    echo -e "  ${GREEN}✔ [PASS]${NC} Clean whitespace: 0 trailing spaces across all staged files."
fi

# ------------------------------------------------------------------------------
# Gate 7: Non-Java Syntax Validation (Shell, JSON, YAML)
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 7/8] Non-Java Syntax Validation (Shell, JSON, YAML)${NC}"
SYNTAX_CHECKED=0
SYNTAX_FAILED=0

PYTHON_CMD=""
if command -v python3 > /dev/null 2>&1; then
    PYTHON_CMD="python3"
elif command -v python > /dev/null 2>&1; then
    PYTHON_CMD="python"
fi

# JSON Validation
JSON_FILES=$(echo "$STAGED_FILES" | grep -E '\.json$' || true)
if [ -n "$JSON_FILES" ] && [ -n "$PYTHON_CMD" ]; then
    while IFS= read -r jf; do
        [ -z "$jf" ] && continue
        SYNTAX_CHECKED=$(( SYNTAX_CHECKED + 1 ))
        if ! (set -o pipefail; git show ":$jf" | $PYTHON_CMD -m json.tool) > /dev/null 2>&1; then
            echo -e "  ${RED}❌ [FAIL] Invalid JSON syntax in:${NC} $jf"
            SYNTAX_FAILED=1
        else
            echo -e "  ${GREEN}✔ [JSON]${NC} Validated: $jf"
        fi
    done <<< "$JSON_FILES"
fi

# Shell Script Validation
SH_FILES=$(echo "$STAGED_FILES" | grep -E '\.sh$' || true)
if [ -n "$SH_FILES" ]; then
    while IFS= read -r sf; do
        [ -z "$sf" ] && continue
        SYNTAX_CHECKED=$(( SYNTAX_CHECKED + 1 ))
        if ! (set -o pipefail; git show ":$sf" | bash -n) 2>/dev/null; then
            echo -e "  ${RED}❌ [FAIL] Shell script syntax error in:${NC} $sf"
            SYNTAX_FAILED=1
        else
            echo -e "  ${GREEN}✔ [Bash]${NC} Syntax verified: $sf"
        fi
    done <<< "$SH_FILES"
fi

# YAML Validation
YAML_FILES=$(echo "$STAGED_FILES" | grep -E '\.(yaml|yml)$' || true)
if [ -n "$YAML_FILES" ] && [ -n "$PYTHON_CMD" ]; then
    while IFS= read -r yf; do
        [ -z "$yf" ] && continue
        SYNTAX_CHECKED=$(( SYNTAX_CHECKED + 1 ))
        if ! $PYTHON_CMD -c 'import subprocess, sys, yaml; list(yaml.safe_load_all(subprocess.check_output(["git", "show", ":" + sys.argv[1]])))' "$yf" > /dev/null 2>&1; then
            if $PYTHON_CMD -c "import yaml" > /dev/null 2>&1; then
                echo -e "  ${RED}❌ [FAIL] Invalid YAML syntax in:${NC} $yf"
                SYNTAX_FAILED=1
            fi
        else
            echo -e "  ${GREEN}✔ [YAML]${NC} Validated: $yf"
        fi
    done <<< "$YAML_FILES"
fi

if [ "$SYNTAX_FAILED" -eq 1 ]; then
    GATE7_STATUS="FAILED"
    FAILED_GATES=$(( FAILED_GATES + 1 ))
elif [ "$SYNTAX_CHECKED" -eq 0 ]; then
    echo -e "  ${DIM}ℹ [SKIP]${NC} No Shell, JSON, or YAML files staged to validate."
    GATE7_STATUS="SKIPPED"
else
    echo -e "  ${GREEN}✔ [PASS]${NC} All ${SYNTAX_CHECKED} script/config file(s) passed syntax validation."
fi

# ------------------------------------------------------------------------------
# Gate 8: Java Code Quality & Multi-Release Build Gates
# ------------------------------------------------------------------------------
echo -e "\n${BOLD}[Gate 8/8] Java Code Quality & Multi-Release Build Gates${NC}"
JAVA_STAGED=$(echo "$STAGED_FILES" | grep -E '(\.java$|pom\.xml$|checkstyle\.xml$)' || true)

if [ -z "$JAVA_STAGED" ]; then
    echo -e "  ${DIM}ℹ [SKIP]${NC} No Java source or build files staged. Skipping Checkstyle and compile gates."
    GATE8_STATUS="SKIPPED"
else
    JAVA_COUNT=$(echo "$JAVA_STAGED" | grep -c . || echo 0)
    echo -e "  ${DIM}Detected ${JAVA_COUNT} Java source / build configuration file(s) staged.${NC}"

    if [ "${PRE_COMMIT_SKIP_JAVA:-0}" = "1" ]; then
        echo -e "  ${YELLOW}⚠ [WARN]${NC} PRE_COMMIT_SKIP_JAVA=1 detected. Skipping Maven gates."
        GATE8_STATUS="BYPASSED"
    else
        MVN_CMD=""
        if command -v mvn > /dev/null 2>&1; then
            MVN_CMD="mvn"
        elif [ -x "./mvnw" ]; then
            MVN_CMD="./mvnw"
        fi

        if [ -z "$MVN_CMD" ]; then
            echo -e "  ${RED}❌ [FAIL] Maven executable ('mvn') not found in PATH!${NC}"
            GATE8_STATUS="FAILED"
            FAILED_GATES=$(( FAILED_GATES + 1 ))
        else
            # Sub-Gate 8.1: Checkstyle
            echo -e "  ${BLUE}• [8.1]${NC} Running Checkstyle verification (mvn checkstyle:check)..."
            CHECKSTYLE_START=$SECONDS
            if CHECKSTYLE_OUTPUT=$($MVN_CMD --batch-mode checkstyle:check 2>&1); then
                CHECKSTYLE_TIME=$(( SECONDS - CHECKSTYLE_START ))
                echo -e "    ${GREEN}✔ [PASS]${NC} Checkstyle passed with 0 violations (${CHECKSTYLE_TIME}s)."
            else
                CHECKSTYLE_TIME=$(( SECONDS - CHECKSTYLE_START ))
                echo -e "    ${RED}❌ [FAIL] Checkstyle violations detected (${CHECKSTYLE_TIME}s):${NC}"
                echo "$CHECKSTYLE_OUTPUT" | grep -E "(\[ERROR\]|violations)" | head -n 20 | while IFS= read -r err; do
                    echo -e "       ${RED}✗${NC} $err"
                done
                GATE8_STATUS="FAILED"
                FAILED_GATES=$(( FAILED_GATES + 1 ))
            fi

            # Sub-Gate 8.2: Test Compilation
            if [ "$GATE8_STATUS" != "FAILED" ]; then
                echo -e "  ${BLUE}• [8.2]${NC} Running test compilation (mvn test-compile -DskipTests)..."
                COMPILE_START=$SECONDS
                if COMPILE_OUTPUT=$($MVN_CMD --batch-mode test-compile -DskipTests 2>&1); then
                    COMPILE_TIME=$(( SECONDS - COMPILE_START ))
                    echo -e "    ${GREEN}✔ [PASS]${NC} Compilation succeeded (${COMPILE_TIME}s)."
                else
                    COMPILE_TIME=$(( SECONDS - COMPILE_START ))
                    echo -e "    ${RED}❌ [FAIL] Compilation failed (${COMPILE_TIME}s):${NC}"
                    echo "$COMPILE_OUTPUT" | tail -n 20 | while IFS= read -r cerr; do
                        echo -e "       ${RED}✗${NC} $cerr"
                    done
                    GATE8_STATUS="FAILED"
                    FAILED_GATES=$(( FAILED_GATES + 1 ))
                fi
            fi

            # Sub-Gate 8.3: Event Loop Safety Gate
            SAFETY_STAGED=$(echo "$STAGED_FILES" | grep -E '(\.java$|(^|/)pom\.xml$|^verification/locking/|^\.github/workflows/eventloop-locks\.yml$|^\.githooks/|^\.pre-commit-config\.yaml$)' || true)
            if [ "$GATE8_STATUS" != "FAILED" ] && [ -n "$SAFETY_STAGED" ]; then
                echo -e "  ${BLUE}• [8.3]${NC} Running event-loop lock safety gate (bash verification/locking/check.sh)..."
                SAFETY_START=$SECONDS
                if bash verification/locking/check.sh > /dev/null 2>&1; then
                    SAFETY_TIME=$(( SECONDS - SAFETY_START ))
                    echo -e "    ${GREEN}✔ [PASS]${NC} Event-loop lock safety gate passed (${SAFETY_TIME}s)."
                else
                    SAFETY_TIME=$(( SECONDS - SAFETY_START ))
                    echo -e "    ${RED}❌ [FAIL] Event-loop lock safety gate failed (${SAFETY_TIME}s):${NC}"
                    echo -e "    ${YELLOW}💡 Remediation:${NC} Run ${BOLD}bash verification/locking/check.sh${NC} to diagnose."
                    GATE8_STATUS="FAILED"
                    FAILED_GATES=$(( FAILED_GATES + 1 ))
                fi
            fi
        fi
    fi
fi

# ------------------------------------------------------------------------------
# Verification Summary Dashboard
# ------------------------------------------------------------------------------
TOTAL_TIME=$(( SECONDS - SCRIPT_START_SECONDS ))
echo -e "\n${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}📊 SocketIO4J Pre-Commit Verification Summary${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

format_status() {
    local status="$1"
    case "$status" in
        "PASSED")   echo -e "${GREEN}✔ PASSED${NC}" ;;
        "FAILED")   echo -e "${RED}❌ FAILED${NC}" ;;
        "SKIPPED")  echo -e "${DIM}ℹ SKIPPED${NC}" ;;
        "BYPASSED") echo -e "${YELLOW}⚠ BYPASSED${NC}" ;;
        *)          echo -e "$status" ;;
    esac
}

echo -e "  Gate 1: Prohibited Cert Files       : $(format_status "$GATE1_STATUS")"
echo -e "  Gate 2: Private Key Content Scanner : $(format_status "$GATE2_STATUS")"
echo -e "  Gate 3: Conflict Markers Check      : $(format_status "$GATE3_STATUS")"
echo -e "  Gate 4: OS & Editor Junk Files      : $(format_status "$GATE4_STATUS")"
echo -e "  Gate 5: File Size Safety (≤500 KB)  : $(format_status "$GATE5_STATUS")"
echo -e "  Gate 6: Whitespace & Line Endings   : $(format_status "$GATE6_STATUS")"
echo -e "  Gate 7: Syntax (Shell, JSON, YAML)  : $(format_status "$GATE7_STATUS")"
echo -e "  Gate 8: Java Quality & Build Gates  : $(format_status "$GATE8_STATUS")"
echo -e "${CYAN}──────────────────────────────────────────────────────────────────${NC}"
echo -e "  ${DIM}Total Verification Time:${NC} ${BOLD}${TOTAL_TIME}s${NC}"

if [ "$FAILED_GATES" -gt 0 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}${BOLD}❌ [BLOCKED] Pre-commit verification failed (${FAILED_GATES} violation(s))!${NC}"
    echo -e "Please address the violations highlighted above and re-attempt commit."
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}${BOLD}✔ All pre-commit integrity gates passed! Proceeding with commit.${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
exit 0
